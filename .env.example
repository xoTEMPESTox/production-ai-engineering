# LLM Provider API Keys
# At least one LLM provider key is required based on the model chosen
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default LLM Model Configurations
# Examples: gpt-4o, gpt-4o-mini, claude-3-5-sonnet-20241022
DEFAULT_MODEL=gpt-4o-mini

# FastAPI Web Server Configurations
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development  # development, staging, production

# PostgreSQL Database Connection
# Used in Part 2 and Part 3 for persistent checkpoints and audits
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/production_ai

# Redis Configuration
# Used for task queueing, state locks, caching, and background workers
REDIS_URL=redis://localhost:6379/0

# Logging & Monitoring
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true

# Security (JWT / Auth if needed)
SECRET_KEY=generate-a-secure-random-secret-key-for-jwt-sessions
ACCESS_TOKEN_EXPIRE_MINUTES=30
